
# Transactional receipts (Resend)
RESEND_API_KEY=
RECEIPT_FROM=SlipSmart <receipts@your-verified-domain.com>
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAILS=admin@example.com

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APISPORTS_KEY=
FOOTBALL_DATA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase web app configuration (safe to expose through /api/config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIRESTORE_USERS_COLLECTION=slipsmart_users

# Server credentials. Prefer Application Default Credentials in production.
# FIREBASE_SERVICE_ACCOUNT_JSON=PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAILS=you@example.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
APISPORTS_KEY=
